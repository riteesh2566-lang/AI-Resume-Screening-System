# Generate a unique secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret
FLASK_DEBUG=false
PORT=5000
COOKIE_SECURE=false

# Optional recruiter bootstrap. Set once before first startup; do not commit real credentials.
BOOTSTRAP_RECRUITER_NAME=Recruiter Admin
BOOTSTRAP_RECRUITER_EMAIL=recruiter@example.com
BOOTSTRAP_RECRUITER_PASSWORD=Ritee@25

# Optional advanced semantic matching (requires: pip install -r requirements-ai.txt)
USE_SEMANTIC_MODEL=false
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2
